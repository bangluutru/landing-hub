{
  "name": "landing-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/src/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test ALLOW_TEST_TOKENS=true USE_FIRESTORE_MEMORY_STUB=true tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^11.4.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
